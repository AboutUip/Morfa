{
  "name": "morfa",
  "version": "0.1.0",
  "private": true,
  "description": "AI 驱动的在线 UI 设计平台（Morfa）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AboutUip/Morfa.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/xaiop/xaiop-sdk/nodejs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace @morfa/web",
    "dev:server": "npm run dev --workspace @morfa/server",
    "build": "npm run build --workspace @morfa/web && npm run typecheck --workspace @morfa/server",
    "preview": "npm run preview --workspace @morfa/web",
    "test": "tsx --test tests",
    "test:visual": "node scripts/visual-baseline.mjs",
    "test:visual:update": "node scripts/visual-baseline.mjs --update",
    "typecheck": "npm run typecheck --workspace @morfa/web && npm run typecheck --workspace @morfa/server",
    "xaiop:build": "npm run build:ts --workspace @bylan280/xaiop",
    "xaiop:test": "npm test --workspace @bylan280/xaiop",
    "xaiop:check": "node scripts/xaiop-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
