{
  "name": "morfa",
  "version": "0.1.0",
  "private": true,
  "description": "AI 驱动的在线 UI 设计平台（Morfa）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AboutUip/Morfa.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/xaiop/xaiop-sdk/nodejs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @morfa/web",
    "dev:web": "npm run dev --workspace @morfa/web",
    "build": "npm run build --workspace @morfa/web",
    "preview": "npm run preview --workspace @morfa/web",
    "typecheck": "npm run typecheck --workspace @morfa/web",
    "xaiop:build": "npm run build:ts --workspace @bylan280/xaiop",
    "xaiop:test": "npm test --workspace @bylan280/xaiop",
    "xaiop:check": "node scripts/xaiop-smoke.mjs"
  }
}
